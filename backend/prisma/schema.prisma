// Prisma Schema for Urban Mobility Data Explorer

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Dimension Table: Taxi Zones
model Zone {
  locationId  Int     @id @map("location_id")
  borough     String  @db.VarChar(50)
  zone        String  @db.VarChar(100)
  serviceZone String  @map("service_zone") @db.VarChar(50)
  geometry    String? @db.Text // GeoJSON polygon

  pickupTrips  Trip[] @relation("PickupLocation")
  dropoffTrips Trip[] @relation("DropoffLocation")

  @@map("zones")
}

// Fact Table: Trips
model Trip {
  tripId                 Int      @id @default(autoincrement()) @map("trip_id")
  vendorId               Int      @map("vendor_id")
  pickupDatetime         DateTime @map("pickup_datetime")
  dropoffDatetime        DateTime @map("dropoff_datetime")
  passengerCount         Int?     @map("passenger_count")
  tripDistance           Decimal  @map("trip_distance") @db.Decimal(10, 2)
  rateCodeId             Int      @map("rate_code_id")
  storeAndFwdFlag        String   @map("store_and_fwd_flag") @db.Char(1)
  puLocationId           Int      @map("pu_location_id")
  doLocationId           Int      @map("do_location_id")
  paymentType            Int      @map("payment_type")
  fareAmount             Decimal  @map("fare_amount") @db.Decimal(10, 2)
  extra                  Decimal  @db.Decimal(10, 2)
  mtaTax                 Decimal  @map("mta_tax") @db.Decimal(10, 2)
  tipAmount              Decimal  @map("tip_amount") @db.Decimal(10, 2)
  tollsAmount            Decimal  @map("tolls_amount") @db.Decimal(10, 2)
  improvementSurcharge   Decimal  @map("improvement_surcharge") @db.Decimal(10, 2)
  totalAmount            Decimal  @map("total_amount") @db.Decimal(10, 2)
  congestionSurcharge    Decimal? @map("congestion_surcharge") @db.Decimal(10, 2)

  // Derived/Engineered Features
  tripDurationMinutes    Int?     @map("trip_duration_minutes")
  speedMph               Decimal? @map("speed_mph") @db.Decimal(10, 2)
  tipPercentage          Decimal? @map("tip_percentage") @db.Decimal(5, 2)
  hourOfDay              Int      @map("hour_of_day")
  dayOfWeek              Int      @map("day_of_week")
  isWeekend              Boolean  @map("is_weekend")
  farePerMile            Decimal? @map("fare_per_mile") @db.Decimal(10, 2)

  pickupZone  Zone @relation("PickupLocation", fields: [puLocationId], references: [locationId])
  dropoffZone Zone @relation("DropoffLocation", fields: [doLocationId], references: [locationId])

  @@index([pickupDatetime])
  @@index([puLocationId])
  @@index([doLocationId])
  @@index([hourOfDay])
  @@map("trips")
}

// Data Quality Log
model DataQualityLog {
  logId            Int      @id @default(autoincrement()) @map("log_id")
  recordData       String   @map("record_data") @db.Text
  exclusionReason  String   @map("exclusion_reason") @db.VarChar(200)
  loggedAt         DateTime @default(now()) @map("logged_at")

  @@map("data_quality_log")
}
